# ============================================================
#  Café API + Frontend
#  Copiar a .env:  cp .env.example .env
#  Los valores son locales de desarrollo, NO secretos reales.
# ============================================================

# --- Base de datos ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cafedb
DB_HOST=postgres
DB_PORT=5432

# --- Comportamiento del backend ---
# Docker local: sin SSL y creando tablas.
# Producción:   DB_SSL=true, DB_SYNCHRONIZE=false
DB_SSL=false
DB_SYNCHRONIZE=true

# --- Frontend ---
# URL que usa el navegador para llamar al API.
# Docker local:  http://localhost:3000
# Kubernetes:    http://api.cafe.local
API_URL=http://localhost:3000

# --- Monitoreo local ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Despliegue (cuando exista el compose de producción) ---
# DOCKERHUB_USERNAME=pablodavid-l
# TAG=latest
